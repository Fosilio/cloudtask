#cloud-config

hostname: ${hostname}
manage_etc_hosts: true

users:
  - name: ${username}
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_key}

ssh_pwauth: false
disable_root: true

package_update: false
package_upgrade: false

growpart:
  mode: auto
  devices: ['/']

resize_rootfs: true